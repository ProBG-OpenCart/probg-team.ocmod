{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ settings }}" data-toggle="tooltip" title="{{ button_global_settings }}" class="btn btn-info"><i class="fa fa-cog"></i></a>
        <button type="submit" form="form-probg-team-block" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title_block }}</h1>
      <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit_block }}</h3></div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-probg-team-block" class="form-horizontal">
          <div class="form-group required">
            <label class="col-sm-2 control-label">{{ entry_name_block }}</label>
            <div class="col-sm-10"><input type="text" name="name" value="{{ name }}" class="form-control" />{% if error_name %}<div class="text-danger">{{ error_name }}</div>{% endif %}</div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_title_block }}</label>
            <div class="col-sm-10">
              {% for language in languages %}
                <div class="input-group" style="margin-bottom:8px"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span><input type="text" name="title[{{ language.language_id }}]" value="{{ title[language.language_id]|default('') }}" class="form-control" /></div>
              {% endfor %}
              <p class="help-block">{{ help_title_block }}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_category_block }}</label>
            <div class="col-sm-10"><select name="team_category_id" class="form-control"><option value="0">{{ text_all_categories }}</option>{% for category in categories %}<option value="{{ category.team_category_id }}" {% if category.team_category_id == team_category_id %}selected{% endif %}>{{ category.name }}</option>{% endfor %}</select></div>
          </div>
          <div class="form-group required">
            <label class="col-sm-2 control-label">{{ entry_limit }}</label>
            <div class="col-sm-10"><input type="number" min="1" name="limit" value="{{ limit }}" class="form-control" />{% if error_limit %}<div class="text-danger">{{ error_limit }}</div>{% endif %}</div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_columns_block }}</label>
            <div class="col-sm-10"><select name="columns" class="form-control">{% for value in [1,2,3,4,6] %}<option value="{{ value }}" {% if value == columns %}selected{% endif %}>{{ value }}</option>{% endfor %}</select></div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_sort_block }}</label>
            <div class="col-sm-10"><select name="sort" class="form-control"><option value="sort_order" {% if sort == 'sort_order' %}selected{% endif %}>{{ text_sort_default }}</option><option value="name" {% if sort == 'name' %}selected{% endif %}>{{ text_sort_name }}</option><option value="date_added" {% if sort == 'date_added' %}selected{% endif %}>{{ text_sort_newest }}</option></select></div>
          </div>
          {% for field,label in {'show_category':entry_show_category_block,'show_city':entry_show_city,'show_description':entry_show_description_block} %}
            <div class="form-group"><label class="col-sm-2 control-label">{{ label }}</label><div class="col-sm-10"><select name="{{ field }}" class="form-control"><option value="1" {% if attribute(_context, field) %}selected{% endif %}>{{ text_yes }}</option><option value="0" {% if not attribute(_context, field) %}selected{% endif %}>{{ text_no }}</option></select></div></div>
          {% endfor %}
          <div class="form-group"><label class="col-sm-2 control-label">{{ entry_status }}</label><div class="col-sm-10"><select name="status" class="form-control"><option value="1" {% if status %}selected{% endif %}>{{ text_enabled }}</option><option value="0" {% if not status %}selected{% endif %}>{{ text_disabled }}</option></select></div></div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
