{{ header }}{{ column_left }}<div id="content"><div class="page-header"><div class="container-fluid"><div class="pull-right"><a href="{{ add }}" class="btn btn-primary"><i class="fa fa-plus"></i></a><button type="button" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" onclick="confirm('{{ text_confirm }}') ? $('#form-category').submit() : false;"><i class="fa fa-trash-o"></i></button></div><h1>{{ heading_title }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div><div class="container-fluid">{% if error_warning %}<div class="alert alert-danger">{{ error_warning }}</div>{% endif %}{% if success %}<div class="alert alert-success">{{ success }}</div>{% endif %}    <ul class="nav nav-tabs">
      <li><a href="index.php?route=extension/module/probg_team&user_token={{ user_token }}">{{ tab_settings }}</a></li>
      <li class="active"><a href="index.php?route=extension/probg_team/category&user_token={{ user_token }}">{{ tab_categories }}</a></li>
      <li><a href="index.php?route=extension/probg_team/member&user_token={{ user_token }}">{{ tab_members }}</a></li>
    </ul>
<div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-list"></i> {{ text_list }}</h3></div><div class="panel-body"><div class="well"><div class="row"><div class="col-sm-5"><input type="text" name="filter_name" value="{{ filter_name }}" placeholder="{{ entry_name }}" class="form-control" /></div><div class="col-sm-5"><select name="filter_status" class="form-control"><option value=""></option><option value="1" {% if filter_status == '1' %}selected{% endif %}>{{ text_enabled }}</option><option value="0" {% if filter_status == '0' %}selected{% endif %}>{{ text_disabled }}</option></select></div><div class="col-sm-2"><a href="{{ clear }}" class="btn btn-default"><i class="fa fa-eraser"></i></a> <button type="button" id="button-filter" class="btn btn-primary"><i class="fa fa-filter"></i></button></div></div></div><form action="{{ delete }}" method="post" id="form-category"><div class="table-responsive"><table class="table table-bordered table-hover"><thead><tr><td style="width:1px"><input type="checkbox" onclick="$(`input[name*='selected']`).prop('checked',this.checked);" /></td><td><a href="{{ sort_name }}">{{ column_name }}</a></td><td class="text-right">{{ column_members }}</td><td class="text-right"><a href="{{ sort_sort_order }}">{{ column_sort_order }}</a></td><td><a href="{{ sort_status }}">{{ column_status }}</a></td><td>{{ column_date_added }}</td><td>{{ column_date_modified }}</td><td class="text-right">{{ column_action }}</td></tr></thead><tbody>{% if categories %}{% for category in categories %}<tr><td><input type="checkbox" name="selected[]" value="{{ category.team_category_id }}" {% if category.team_category_id in selected %}checked{% endif %}/></td><td>{{ category.name }}</td><td class="text-right">{{ category.member_total }}</td><td class="text-right">{{ category.sort_order }}</td><td>{{ category.status }}</td><td>{{ category.date_added }}</td><td>{{ category.date_modified }}</td><td class="text-right"><a href="{{ category.view }}" target="_blank" class="btn btn-info"><i class="fa fa-eye"></i></a> <a href="{{ category.edit }}" class="btn btn-primary"><i class="fa fa-pencil"></i></a></td></tr>{% endfor %}{% else %}<tr><td colspan="8" class="text-center">{{ text_no_results }}</td></tr>{% endif %}</tbody></table></div></form><div class="row"><div class="col-sm-6 text-left">{{ pagination }}</div><div class="col-sm-6 text-right">{{ results }}</div></div></div></div></div></div><script>$('#button-filter').on('click',function(){location='index.php?route=extension/probg_team/category&user_token={{ user_token }}&filter_name='+encodeURIComponent($('input[name=filter_name]').val())+'&filter_status='+encodeURIComponent($('select[name=filter_status]').val());});</script>{{ footer }}
